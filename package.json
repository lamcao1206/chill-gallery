{
  "name": "express-image-gallery",
  "version": "1.0.0",
  "description": "Express image/video gallery backed by S3 + Supabase, with JWT auth and zip upload",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js --env-file=.env",
    "dev": "node --watch src/server.js --env-file=.env",
    "create-user": "node scripts/create-user.js",
    "migrate": "node scripts/migrate-to-s3.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "unzipper": "^0.12.3"
  },
  "engines": {
    "node": ">=20"
  }
}
