# ========================================
# Server
# ========================================
PORT=8000
NODE_ENV=production

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login stays valid.
JWT_EXPIRES_IN=7d

# There is no public sign-up. Create your single account with:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='a-strong-password' npm run create-user
# (Pass these inline when running the script; no need to keep them in .env.)

# ========================================
# Supabase
# ========================================
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Secret API key (new format, starts with "sb_secret_").
# Server-side only — bypasses RLS, NEVER expose it to the browser.
# Dashboard -> Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=

# The following are NOT needed by this app and can be left blank:
#   - SUPABASE_PUBLISHABLE_KEY: only for browser/anon clients (this app has none).
#   - SUPABASE_JWKS_URL: only for verifying Supabase Auth tokens; we issue our own JWTs.

# ========================================
# AWS S3
# ========================================
AWS_REGION=ap-southeast-1
S3_BUCKET=your-gallery-bucket
# Prefix (folder) inside the bucket where everything is stored.
S3_PREFIX=galleries
# How long presigned image URLs stay valid (seconds).
S3_URL_TTL=3600

# Credentials. On EC2, prefer an IAM instance role and leave these blank.
# For local dev / migration, set them here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ========================================
# Migration script only
# ========================================
# Absolute or relative path to the existing local images directory.
# Defaults to ../images (the sibling FastAPI project's images folder).
LOCAL_IMAGE_ROOT=../images
